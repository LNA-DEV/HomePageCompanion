{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "error": {
                  "properties": {
                    "cause": {
                      "description": "the provider's own classification",
                      "enum": [
                        "account",
                        "content",
                        "transient"
                      ],
                      "type": "string"
                    },
                    "code": {
                      "description": "a known code, or another one",
                      "examples": [
                        "bad_request",
                        "identity_unknown",
                        "internal",
                        "needs_image",
                        "not_a_profile",
                        "not_connected",
                        "rate_limited",
                        "self",
                        "unavailable",
                        "unsupported"
                      ],
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "status": {
                      "description": "the HTTP status the platform answered",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          }
        },
        "description": "the operation failed"
      }
    },
    "schemas": {
      "Image": {
        "description": "Image is an image to attach. URL is a public http(s) URL or a URL of the\ncore (companion.Fetch resolves both); Instagram and Threads hand it to\nthe platform, which fetches it itself.",
        "properties": {
          "alt": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "Limits": {
        "description": "Limits is what a target accepts.",
        "properties": {
          "account": {
            "type": "string"
          },
          "contentWarning": {
            "description": "native support",
            "type": "boolean"
          },
          "lengthUnit": {
            "description": "LengthUnit is how the network counts: \"rune\" (default) or\n\"utf8-emoji\" (Threads: an emoji counts as its UTF-8 bytes).",
            "type": "string"
          },
          "linkCard": {
            "description": "LinkCard: \"auto\" (the network builds the card from a link in the\ntext), \"manual\" (the sender supplies it) or \"\" (none).",
            "type": "string"
          },
          "maxHashtags": {
            "description": "0 = unlimited",
            "type": "integer"
          },
          "maxImages": {
            "type": "integer"
          },
          "maxLength": {
            "type": "integer"
          },
          "maxMentions": {
            "type": "integer"
          },
          "mentionProfiles": {
            "description": "MentionProfiles are the profile kinds (lna:profile platforms) the\nnetwork can mention, preferred first; MaxMentions caps them per post.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "platform": {
            "description": "network key: mastodon, bluesky …",
            "type": "string"
          },
          "requiresImage": {
            "type": "boolean"
          }
        },
        "required": [
          "platform",
          "maxLength"
        ],
        "type": "object"
      },
      "LinkCard": {
        "description": "LinkCard is the preview of a link.",
        "properties": {
          "description": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "ListedPost": {
        "description": "ListedPost is one of the account's own posts.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "imageUrls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ref": {
            "$ref": "#/components/schemas/Result"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "createdAt"
        ],
        "type": "object"
      },
      "Mention": {
        "description": "Mention is a person mentioned in a post.",
        "properties": {
          "account": {
            "description": "DID, username or canonical acct",
            "type": "string"
          },
          "text": {
            "description": "as in the post: \"@jane\", \"@jane@mastodon.social\"",
            "type": "string"
          }
        },
        "required": [
          "text",
          "account"
        ],
        "type": "object"
      },
      "Post": {
        "description": "Post is what a building block wants posted.",
        "properties": {
          "contentWarning": {
            "description": "ContentWarning is shown before the text where the network supports\nit, else prepended as \"CW: …\".",
            "type": "string"
          },
          "idempotencyKey": {
            "description": "IdempotencyKey is the same for every try of this post on this\ntarget. A network that honours one (Mastodon's Idempotency-Key)\ncreates the post once, even when the answer to a try got lost, e.g.\nbecause the companion was stopped or killed during the call.",
            "type": "string"
          },
          "images": {
            "description": "may be empty (blog post)",
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "itemId": {
            "type": "string"
          },
          "kind": {
            "description": "photo | article | note",
            "type": "string"
          },
          "link": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LinkCard"
              }
            ],
            "description": "URL, title, description, preview image"
          },
          "mentions": {
            "description": "Mentions are the mentions the text contains, as ResolveMention\nreturned them; networks that need facets or photo tags read them here.",
            "items": {
              "$ref": "#/components/schemas/Mention"
            },
            "type": "array"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "itemId",
          "kind",
          "text",
          "images"
        ],
        "type": "object"
      },
      "Rendered": {
        "description": "Rendered is a preview.",
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "link": {
            "$ref": "#/components/schemas/LinkCard"
          },
          "text": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "Result": {
        "description": "Result identifies a published post on its network. ID is the network's\nid (a Mastodon status id, an Instagram media id, a Bluesky at:// URI),\nURL its public web page, Version a network-specific version (Bluesky's\nCID).",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Publisher posts to one account on a network.\n\nGenerated by hpc gen from github.com/LNA-DEV/HomePageCompanion/capability/social.Publisher. A service offering it answers these paths; requests from the core carry the Companion-Signature header (docs/services/protocol.md).",
    "title": "social.publisher/v1",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/capabilities/social.publisher/v1/delete": {
      "post": {
        "description": "Deleter is the optional delete operation of social.publisher/v1. A post\nthat is already gone counts as deleted.",
        "operationId": "delete",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Result"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Deleter is the optional delete operation of social.publisher/v1.",
        "x-optional": true
      }
    },
    "/capabilities/social.publisher/v1/describe": {
      "post": {
        "description": "Describe reports what the target accepts.",
        "operationId": "describe",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {},
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Limits"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Describe reports what the target accepts."
      }
    },
    "/capabilities/social.publisher/v1/listPosts": {
      "post": {
        "description": "Lister is the optional listPosts operation of social.publisher/v1: the\naccount's own posts, newest first, for matching old posts to feed items.",
        "operationId": "listPosts",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {},
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ListedPost"
                  },
                  "type": "array"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Lister is the optional listPosts operation of social.publisher/v1: the account's own posts, newest first, for matching old posts to feed items.",
        "x-optional": true
      }
    },
    "/capabilities/social.publisher/v1/preview": {
      "post": {
        "description": "Preview renders the post as the platform will show it, without\nsending anything.",
        "operationId": "preview",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rendered"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Preview renders the post as the platform will show it, without sending anything."
      }
    },
    "/capabilities/social.publisher/v1/publish": {
      "post": {
        "description": "Publish sends the post.",
        "operationId": "publish",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Publish sends the post."
      }
    },
    "/capabilities/social.publisher/v1/resolveMention": {
      "post": {
        "description": "ResolveMention turns a profile URL into a mention on this network.\nErrNotAProfile: the URL is not a profile the network can mention, try\nthe next one. ErrSelf: the profile is the posting account.\nErrIdentityUnknown: the posting account's identity could not be\nread, so nobody can be mentioned safely.",
        "operationId": "resolveMention",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "profileUrl": {
                    "type": "string"
                  }
                },
                "required": [
                  "profileUrl"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mention"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "ResolveMention turns a profile URL into a mention on this network."
      }
    }
  }
}
