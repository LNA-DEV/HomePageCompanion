{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "error": {
                  "properties": {
                    "cause": {
                      "description": "the provider's own classification",
                      "enum": [
                        "account",
                        "content",
                        "transient"
                      ],
                      "type": "string"
                    },
                    "code": {
                      "description": "a known code, or another one",
                      "examples": [
                        "bad_request",
                        "internal",
                        "unavailable",
                        "unsupported"
                      ],
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "status": {
                      "description": "the HTTP status the platform answered",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          }
        },
        "description": "the operation failed"
      }
    },
    "schemas": {
      "Message": {
        "description": "Message is a notification.",
        "properties": {
          "body": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Notifier delivers messages.\n\nGenerated by hpc gen from github.com/LNA-DEV/HomePageCompanion/capability/notify.Notifier. A service offering it answers these paths; requests from the core carry the Companion-Signature header (docs/services/protocol.md).",
    "title": "notify/v1",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/capabilities/notify/v1/broadcast": {
      "post": {
        "description": "Broadcast delivers to every recipient.",
        "operationId": "broadcast",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Message"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Broadcast delivers to every recipient."
      }
    },
    "/capabilities/notify/v1/send": {
      "post": {
        "description": "Send delivers to one recipient of the notifier (a subscription id).",
        "operationId": "send",
        "parameters": [
          {
            "description": "The provider's instance the call is for (\"main\").",
            "in": "header",
            "name": "Companion-Instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "message": {
                    "$ref": "#/components/schemas/Message"
                  },
                  "to": {
                    "type": "string"
                  }
                },
                "required": [
                  "to",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "done"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Send delivers to one recipient of the notifier (a subscription id)."
      }
    }
  }
