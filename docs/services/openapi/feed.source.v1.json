            "description": "the feed's GUID",
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          },
          "kind": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "type": "array"
          },
          "published": {
            "format": "date-time",
            "type": "string"
          },
          "summary": {
            "description": "plain-text excerpt",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "link",
          "published",
          "hasDate"
        ],
        "type": "object"
      },
      "Person": {
        "description": "Person is someone shown in a photo (lna:model). See\ndocs/concepts/autouploader-model-tags.md for the feed contract.",
        "properties": {
          "autotag": {
            "description": "agreed to be mentioned",
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/Profile"
