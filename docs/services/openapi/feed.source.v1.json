                    "code",
                    "message"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          }
        },
        "description": "the operation failed"
      }
    },
    "schemas": {
      "Image": {
        "description": "Image is an item's image. URL is the one to post (the feed's\nmedia:content); OriginalURL is the full file with its metadata intact\n(the enclosure), when the feed has one.",
        "properties": {
          "alt": {
            "type": "string"
          },
          "originalUrl": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "Item": {
        "description": "Item is one post of a feed.",
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "copyright": {
            "description": "the feed's copyright line",
            "type": "string"
          },
          "description": {
            "description": "the feed's HTML",
            "type": "string"
          },
          "feedTitle": {
            "type": "string"
          },
          "hasDate": {
            "description": "HasDate is false when the feed gave no date; Published is then the\ntime the item was first seen.",
