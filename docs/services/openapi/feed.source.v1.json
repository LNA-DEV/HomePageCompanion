            "type": "array"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "autotag"
        ],
        "type": "object"
      },
      "Profile": {
        "description": "Profile is one profile of a Person; Platform is a lowercase key such as\n\"instagram\" or \"mastodon\".",
        "properties": {
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "url"
        ],
        "type": "object"
      }
    }
