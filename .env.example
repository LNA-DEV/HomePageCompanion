# Copy this file to .env and fill in the secret values. .env is gitignored.
#
# Lines starting with '#' are comments. Values may be wrapped in single or
# double quotes if they contain spaces. Values present in the OS environment
# already (e.g. exported in the shell or set by docker compose) win over
# whatever is here.
#
# Reference any of these in src/data/config.yaml via ${NAME} or
# ${NAME:-fallback}; see src/data/config.yaml.example for a fully templated
# example.

# ---- Admin / security ------------------------------------------------------
# Used by the SvelteKit admin UI and every /api/admin/* endpoint.
ADMIN_API_KEY=
# Salt applied when hashing IPs for native-likes deduplication.
IP_HASH_SALT=

# ---- Pixelfed --------------------------------------------------------------
PIXELFED_PAT=
PIXELFED_INSTANCE=https://pixelfed.de

# ---- Bluesky ---------------------------------------------------------------
BLUESKY_USERNAME=
BLUESKY_PAT=

# ---- Instagram Graph -------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ---- Mastodon (used by autouploader + microblog) ---------------------------
MASTODON_INSTANCE=
MASTODON_PAT=

# ---- Threads (used by autouploader + microblog) ----------------------------
# Long-lived Threads Graph API access token + your Threads user id.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ---- Webpush ---------------------------------------------------------------
# The "subscriber" string sent to web-push providers (usually mailto: URL).
WEBPUSH_SUBSCRIBER_MAIL=
