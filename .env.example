# Copy this file to data/.env and fill in the values; .env is gitignored.
#
# Lines starting with '#' are comments. Values may be wrapped in single or
# double quotes if they contain spaces. Values present in the OS environment
# already (e.g. exported in the shell or set by docker compose) win over
# whatever is here.
#
# companion.yaml reads them as ${NAME} or ${NAME:-fallback}; see
# companion.yaml.example.

# ---- Core ------------------------------------------------------------------
# The admin login of the admin UI, and the "Authorization: ApiKey <key>"
# header for scripts.
ADMIN_API_KEY=
COMPANION_DOMAIN=example.com
# Encrypts the secret store (refreshed and connected tokens, the VAPID key).
# 32 bytes, base64: `openssl rand -base64 32`. Without it the core generates
# one into data/secret.key; keep that file with the backups.
COMPANION_SECRET_KEY=
# The reverse proxies whose X-Forwarded-For is believed: IPs or CIDRs,
# comma-separated; "none" for none. Unset: the private networks.
# TRUSTED_PROXIES=

# ---- Website ---------------------------------------------------------------
# Salt applied when hashing IPs for website likes.
IP_HASH_SALT=
# The "subscriber" sent to web-push providers (usually a mailto: URL).
WEBPUSH_SUBSCRIBER_MAIL=

# ---- Accounts ----------------------------------------------------------------
# Mastodon, Pixelfed, Instagram and Threads accounts can be connected on
# their settings page instead (OAuth); then their token stays empty here.
MASTODON_INSTANCE=
MASTODON_PAT=

PIXELFED_INSTANCE=https://pixelfed.de
PIXELFED_PAT=

BLUESKY_USERNAME=
# An app password.
BLUESKY_PAT=

# The Instagram app's ID and secret (Meta dashboard: Instagram > API setup
# with Instagram login), to connect the account; or the token directly.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# The Threads app's ID and secret (not the Meta app's), to connect the
# account; or a long-lived token and the Threads user id directly.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ---- Object storage (S3) ---------------------------------------------------
# Credentials for the bucket of blob.s3 (companion.yaml). Read by the AWS SDK
# under exactly these names. Leave empty with blob.fs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
