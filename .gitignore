# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file

# env file
.env

companion.db
src/data/config.yaml

__debug*

# Built binaries (the old one, and hpc build's default output)
/home-page-companion
/src/home-page-companion
# hpc build -o companion at the root writes into the SDK directory
/companion/companion

# Node.js / SvelteKit
web/node_modules/
web/build/
web/.svelte-kit/

# SQLite temporary files
*.db-journal
*.db-wal
*.db-shm
src/cmd/migrate-guids/main.go
src/data/logs/**
src/data/microblog/**
src/data/trips/**
.inbox/**

# The old installation the migration's end-to-end test moves over.
!e2e/testdata/legacy/.env
!e2e/testdata/legacy/companion.db

# Module UIs, staged and built by web/scripts/build-modules.mjs
web/.modules/
web/build-modules/

# Playwright
web/test-results/
web/playwright-report/
web/ui-screenshots/

# hpc apply: the generated compose file and the git sources it builds
/compose.generated.yml
/.hpc/
